node_modules
dist
dev-dist
.DS_Store
*.log
.vite

# 素材の作業フォルダ。ID と元ファイル名の対応表（raw/id-map.json）も入るので、
# これが公開されると答えが分かってしまう
/raw/*
!/raw/real/
!/raw/ai/
/raw/real/*
/raw/ai/*
!/raw/real/.gitkeep
!/raw/ai/.gitkeep

# 映写室版で使っていた作業フォルダ（いまは未使用）
/clips/
/sources/
/saved/
/refs/
/_preview/
/venv/

# 実素材を入れたので、配信する動画はリポジトリに含める。
# ダミーに戻すときは、この下に /public/clips/*.mp4 を書けば管理外にできる
