node_modules
dist
dev-dist
.DS_Store
*.log
.vite

# 実素材・作業用フォルダはリポジトリに含めない（巨大なため）
# clips/  : prep:clip に渡す加工前の素材
# sources/: 元の映画（clip_picker.py の入力）
# saved/  : 切り出した10秒クリップ（本物ストック）
# refs/   : AI生成に渡す参照クリップ
# _preview/: clip_picker.py の一時ファイル
# venv/   : clip_picker.py 用の Python 仮想環境
/clips/*
!/clips/.gitkeep
/sources/
/saved/
/refs/
/_preview/
/venv/

# 生成物（npm run gen:dummy で決定的に再生成できるため git 管理外）
/public/clips/*.mp4
