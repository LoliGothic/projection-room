node_modules
dist
dev-dist
.DS_Store
*.log
.vite

# 素材の作業フォルダ。ID と元ファイル名の対応表（raw/id-map.json）も入るので、
# これが公開されると答えが分かってしまう
/raw/*
!/raw/real/
!/raw/ai/
/raw/real/*
/raw/ai/*
!/raw/real/.gitkeep
!/raw/ai/.gitkeep

# 映写室版で使っていた作業フォルダ（いまは未使用）
/clips/
/sources/
/saved/
/refs/
/_preview/
/venv/

# ダミー動画は npm run gen:dummy で決定的に再生成できるため git 管理外。
# 実素材に差し替えたら、この行を外して mp4 をリポジトリに含めること
/public/clips/*.mp4
